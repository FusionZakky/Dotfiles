{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "color": { "1": "{{colors.primary.default.hex}}", "2": "{{colors.primary.default.hex}}" }
  },
  "display": {
    "separator": " ",
    "color": { "keys": "{{colors.primary.default.hex}}", "title": "{{colors.primary.default.hex}}" }
  },
  "modules": [
    { "type": "title", "color": { "user": "{{colors.primary.default.hex}}", "at": "{{colors.primary.default.hex}}", "host": "{{colors.primary.default.hex}}" } },
    "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "wmtheme", "theme", "icons", "font", "cursor",
    "terminal", "terminalfont", "cpu", "gpu", "memory", "swap", "disk",
    "localip", "battery", "poweradapter", "locale", "break", "colors"
  ]
}
