bleopt prompt_ps1_final='$(starship module character)'
ble-face command_builtin='fg=243'
ble-face command_alias='fg=4'
ble-face command_function='fg=4'
ble-face command_file='fg=4'
ble-face command_keyword='fg=243,bold'
ble-face command_directory='fg=6,underline'
ble-face argument_option='fg=6'
ble-face argument_error='fg=244'
ble-face syntax_error='fg=244,underline'
ble-face syntax_quoted='fg=251'
ble-face syntax_varname='fg=2'
ble-face syntax_comment='fg=8'
ble-face filename_directory='fg=6,underline'
ble-face auto_complete='fg=8'
bleopt prompt_ps1_transient=always

# Enter always runs the buffer (pasted multi-line blocks and heredocs run instead of waiting)
ble-bind -m emacs -f RET accept-line
ble-bind -m emacs -f C-m accept-line

# Ctrl+Shift+V: paste straight from the Wayland clipboard (terminal forwards the key to ble.sh)
ble-bind -x 'C-S-v' 'my/wl-paste-big'
ble-face varname_new='fg=251'
ble-face filename_executable='fg=4,underline'
bleopt highlight_timeout_sync=10
ble-face syntax_document='fg=251'
ble-face syntax_document_begin='fg=251,bold'

function my/wl-paste-big {
  local t n
  t=$(wl-paste -n 2>/dev/null) || return
  n=$(printf '%s' "$t" | wc -l)
  if ((n>15)); then printf '%s\n' "$t" > /tmp/bigpaste.sh; t='. /tmp/bigpaste.sh'; fi
  READLINE_LINE=${READLINE_LINE:0:READLINE_POINT}${t}${READLINE_LINE:READLINE_POINT}
  READLINE_POINT=$((READLINE_POINT+${#t}))
}
# olive-fix: fixed olive fg colours -> slot 251
ble-face varname_number='fg=251'
ble-face varname_hash='fg=251,bold'
# --- fish-colour-logic (generated) ---
ble-face command_builtin='none'
ble-face command_alias='none'
ble-face command_function='none'
ble-face command_file='none'
ble-face command_keyword='none'
ble-face syntax_quoted='fg=3'
ble-face syntax_quotation='fg=3'
ble-face syntax_document='fg=3'
ble-face syntax_document_begin='fg=3'
ble-face argument_option='fg=6'
ble-face syntax_default='fg=6'
ble-face syntax_error='fg=9'
ble-face argument_error='fg=9'
ble-face syntax_comment='fg=1'
ble-face syntax_delimiter='fg=2'
ble-face syntax_glob='fg=14'
ble-face syntax_tilde='fg=14'
ble-face syntax_escape='fg=14'
ble-face auto_complete='fg=8'
# --- end fish-colour-logic ---
